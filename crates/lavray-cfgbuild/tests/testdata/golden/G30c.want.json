      {
        "outbound": "block",
        "rule_set": [
          "geosite-category-ads-all"
        ]
      },
      {
        "network": [
          "udp"
        ],
        "outbound": "block",
        "port": [
          135,
          137,
          138,
          139,
          5353
        ]
      },
      {
        "ip_cidr": [
          "224.0.0.0/3",
          "ff00::/8"
        ],
        "outbound": "block"
      },
      {
        "outbound": "block",
