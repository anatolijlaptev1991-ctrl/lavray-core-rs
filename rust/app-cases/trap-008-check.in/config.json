{
  "dns": {
    "servers": [
      {
        "tag": "dns-remote",
        "type": "https",
        "server": "dns.google",
        "detour": "proxy"
      },
      {
        "tag": "dns-direct",
        "type": "local"
      }
    ],
    "rules": [
      {
        "clash_mode": "Direct",
        "server": "dns-direct"
      }
    ],
    "final": "dns-remote",
    "strategy": "prefer_ipv4"
  },
  "route": {
    "final": "proxy",
    "auto_detect_interface": true,
    "default_domain_resolver": "dns-direct"
  },
  "inbounds": [
    {
      "type": "mixed",
      "tag": "in",
      "listen": "127.0.0.1",
      "listen_port": 2080
    }
  ],
  "outbounds": [
    {
      "type": "direct",
      "tag": "proxy"
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}