{
  "version": 3,
  "rules": [
    {
      "domain": [
        "accounts.google.com",
        "www.google.com"
      ]
    },
    {
      "domain_suffix": [
        ".googleapis.com",
        ".doubleclick.net"
      ]
    },
    {
      "domain_keyword": "gemini"
    },
    {
      "domain_regex": "^ads-[0-9]+\\.example\\.com$"
    }
  ]
}

